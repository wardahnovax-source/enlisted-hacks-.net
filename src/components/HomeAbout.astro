---
import HomeAboutApp from './react/HomeAbout';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
---

<HomeAboutApp client:visible locale={locale} />

<style is:global>
	.home-about {
		padding-block: clamp(2.25rem, 4.5vw, 3.25rem);
		border-bottom: 1px solid var(--line-soft);
	}

	.home-about__head {
		max-width: 42rem;
		margin-bottom: clamp(1.5rem, 3vw, 2rem);
	}

	.home-about__eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.home-about__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.85rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--ink);
	}

	.home-about__lede {
		margin: 0.75rem 0 0;
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.home-about__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: clamp(1rem, 2.5vw, 1.5rem);
		align-items: start;
	}

	.home-about__subhead {
		margin: 0 0 0.85rem;
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-hover);
	}

	.home-about__feature-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.65rem;
	}

	.home-about__feature {
		display: flex;
		gap: 0.75rem;
		padding: 0.85rem 0.95rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
		transition: border-color 0.2s ease;
	}

	.home-about__feature:hover {
		border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
	}

	.home-about__feature-icon {
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		border-radius: 0.5rem;
		font-size: 0.7rem;
		font-weight: 800;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
	}

	.home-about__feature strong {
		display: block;
		margin-bottom: 0.2rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--accent-hover);
	}

	.home-about__feature p {
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.45;
		color: var(--ink-faint);
	}

	.home-about__aside {
		display: grid;
		gap: 0.85rem;
	}

	.home-about__card {
		padding: 1.15rem 1.2rem;
		border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--line));
		border-radius: var(--radius-md);
		background:
			radial-gradient(ellipse 80% 60% at 100% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 55%),
			var(--bg-panel);
	}

	.home-about__card > p {
		margin: 0 0 0.85rem;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.home-about__checks {
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.home-about__checks li {
		position: relative;
		padding-left: 1.25rem;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--ink-muted);
	}

	.home-about__checks li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--accent);
		font-weight: 700;
	}

	.home-about__cta {
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
		padding: 0.55rem 1rem;
		border-radius: var(--radius-sm);
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--tone-void, #070805);
		background: linear-gradient(135deg, var(--accent-hover), var(--accent));
		text-decoration: none;
		transition: filter 0.2s ease;
	}

	.home-about__cta:hover {
		filter: brightness(1.08);
		color: var(--tone-void, #070805);
	}

	.home-about__links {
		padding: 1rem 1.15rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
	}

	.home-about__links ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.home-about__links a {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--ink-muted);
		background: color-mix(in srgb, var(--bg-elevated) 60%, transparent);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			background 0.15s ease;
	}

	.home-about__links a:hover {
		border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
		color: var(--accent-hover);
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}

	@media (max-width: 900px) {
		.home-about__grid {
			grid-template-columns: 1fr;
		}

		.home-about__feature-list {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 480px) {
		.home-about {
			padding-block: 1.75rem;
		}
	}
</style>
